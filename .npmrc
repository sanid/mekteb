# React Native and Expo resolve native modules by walking node_modules, and
# assume a hoisted layout. pnpm's default isolated store breaks that — the
# bundler cannot find transitive deps like @expo/metro-runtime's whatwg-fetch,
# which are never listed as direct dependencies of anything we own.
#
# This is Expo's documented setting for pnpm monorepos. It applies to the whole
# workspace, including apps/web.
node-linker=hoisted
