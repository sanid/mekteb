NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Service role key is server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Resend (transactional email)
RESEND_API_KEY=re_xxxx
# Verified sender address in Resend dashboard, e.g. "Mekteb <no-reply@mekteb.app>"
EMAIL_FROM=Mekteb <no-reply@your-domain.com>
# Public URL of the deployed app (used for links in notification emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret to protect the /api/notifications/send-emails cron endpoint
CRON_SECRET=replace-with-random-secret

# Native push (APNs + FCM). Without these the push cron no-ops.
# APNs: create an Auth Key (Keys tab, tick "Apple Push Notifications service")
# in the Apple Developer portal and download the .p8. One key covers sandbox
# and production. Set APNS_ENV=sandbox for TestFlight/dev builds.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE=de.mekteb.app
APNS_ENV=production
# FCM: Firebase → Project settings → Service accounts → Generate new private
# key. The JSON needs the "Firebase Cloud Messaging Admin" role. The Android
# app also needs google-services.json in apps/mobile + googleServicesFile in
# app.config.ts, or it cannot register an FCM token at all.
FCM_SERVICE_ACCOUNT=
# Same value as the app.push_webhook_config secret in the database. The
# pg_net insert trigger and the cron both authenticate here with this token.
PUSH_WEBHOOK_SECRET=replace-with-random-secret

# Pre-launch curtain over the public marketing pages. Leave blank to disable
# the gate entirely (the default for local dev and preview deploys). It is not
# an authorization control — everything that matters sits behind Supabase auth
# and RLS — it only keeps the unfinished public site off casual links.
SITE_GATE_PASSWORD=

# Upstash Redis (rate limiting for login/OTP/password-reset etc.)
# Get from: Vercel project → Storage → Marketplace → Upstash → connect, or
# https://console.upstash.com → create a Redis database → REST API section.
# Without these, rate limiting falls back to an in-memory, per-instance
# store — not a real guarantee across multiple serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring (optional — leave blank to disable in local dev)
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only — needed by @sentry/nextjs webpack plugin for source map upload
# Get from: https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=mekteb

# Site operator details for the Impressum (§ 5 TMG) and the public footer.
# German law requires a real name and postal address on a publicly reachable
# site, so whoever deploys an instance fills these in for themselves. They are
# deliberately kept out of the repository — leave them blank in local dev and
# the Impressum renders with empty fields.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_STREET=
NEXT_PUBLIC_OPERATOR_POSTAL_CITY=
NEXT_PUBLIC_OPERATOR_COUNTRY=Deutschland
NEXT_PUBLIC_CONTACT_EMAIL=
