{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APPLE_TEAM_ID": "${APPLE_TEAM_ID}"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APPLE_TEAM_ID": "${APPLE_TEAM_ID}",
        "EXPO_PUBLIC_API_URL": "https://mekteb.de"
      }
    },
    "production": {
      "env": {
        "APPLE_TEAM_ID": "${APPLE_TEAM_ID}",
        "EXPO_PUBLIC_API_URL": "https://mekteb.de"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
